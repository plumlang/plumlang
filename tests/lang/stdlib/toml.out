== tables.toml
{
  "name": "Orange",
  "physical": {
    "color": "orange",
    "shape": "round"
  },
  "site": {
    "google.com": true
  },
  "": "an empty key",
  "ʎǝʞ": "a key that isn't ASCII",
  "quoted \"key\"": 1,
  "3": {
    "14159": "pi"
  },
  "x": {
    "y": {
      "z": {
        "w": {
          "deep": true
        }
      }
    },
    "top": true
  },
  "fruit": {
    "apple": {
      "color": "red",
      "taste": {
        "sweet": true
      },
      "texture": {
        "smooth": true
      }
    }
  },
  "dog": {
    "tater.man": {
      "type": {
        "name": "pug"
      }
    }
  },
  "inline": {
    "point": {
      "x": 1,
      "y": 2
    },
    "nested": {
      "a": {
        "b": 1
      },
      "c": {
        "d": [
          1,
          {
            "e": 2
          }
        ]
      }
    },
    "empty": {}
  },
  "fruits": [
    {
      "name": "apple",
      "physical": {
        "color": "red"
      },
      "varieties": [
        {
          "name": "red delicious"
        },
        {
          "name": "granny smith"
        }
      ]
    },
    {
      "name": "banana",
      "varieties": [
        {
          "name": "plantain"
        }
      ]
    }
  ],
  "mixed": {
    "array": [
      1,
      "two",
      3.0,
      [
        4
      ],
      {
        "five": 5
      }
    ],
    "trailing": [
      1,
      2
    ]
  }
}
