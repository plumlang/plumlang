# The math module: seed forms, num results, rounding, random numbers, errors.
seed math
seed math as m
seed math { sqrt, PI, max }

drop(math.sqrt(2.0), sqrt(16), m.PI, PI * 2.0)
drop(math.abs(-5), math.abs(-2.5), max(3, 9), math.max(3, 9.5), math.min(-1, 1))
drop(math.floor(2.7), math.ceil(2.1), math.round(2.5), math.round(3.14159, digits: 2))
drop(math.clamp(15, 0, 10), math.log(math.E), math.log(8.0, 2.0), math.MAX_INT)
math.seed_random(42)
plant a = [math.random_int(1, 6), math.random_int(1, 6), math.random_int(1, 6)]
math.seed_random(42)
plant b = [math.random_int(1, 6), math.random_int(1, 6), math.random_int(1, 6)]
drop(a == b, a.all((x) => x >= 1 and x <= 6))
plant r = math.random()
drop(r >= 0.0 and r < 1.0, math.is_nan(math.INF - math.INF), math.is_finite(math.INF))
try { drop(math.sqrt(-1.0)) } catch e: ValueError { drop(e.message) }
try { drop(math.floor(1e300)) } catch e: OverflowError { drop(e.message) }

