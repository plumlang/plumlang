# semver: parsing (prerelease and build), precedence as semver.org
# orders it, sorting, ranges with the same syntax as plum.toml (and
# prereleases in them), max_satisfying, bump, and what's rejected.
seed semver

drop(semver.parse("1.2.3"))
drop(semver.parse("1.0.0-alpha.1+exp.sha.5114f85"))
drop(semver.parse("0.0.0"), semver.parse("999999999.0.1-0+001"))
drop(semver.parse("1.0.0-x-y-z.--"), semver.parse("1.0.0+21AF26D3----117B344092BD"))

for text in ["1.2.3", "1.2.3-0", "1.2.3-0a", "1.2.3+007", "1.2", "1", "01.2.3", "1.02.3", "1.2.3-01",
             "1.2.3-", "1.2.3+", "1.2.3-a..b", "1.2.3-a_b", "v1.2.3", " 1.2.3", "1.2.3 ", "1.2.3.4",
             "1000000000.0.0", "999999999.999999999.999999999", "", "1.2.3-alpha+", "-1.2.3"] {
    drop("{text:>32} {semver.is_valid(text)}")
}

# precedence: semver.org item 11's example, each before the next
plant order = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2",
               "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "1.0.1", "1.1.0", "2.0.0", "10.0.0"]
plant ok = good
for i in 0..len(order) {
    for j in 0..len(order) {
        plant want = if i < j { -1 } else if i > j { 1 } else { 0 }
        if semver.compare(order[i], order[j]) != want {
            ok = bad
            drop("wrong: {order[i]} vs {order[j]}")
        }
    }
}
drop("precedence:", ok)
drop(semver.compare("1.0.0+a", "1.0.0+b"), semver.compare("1.0.0-1", "1.0.0-a"), semver.compare("1.0.0-2", "1.0.0-10"))

drop(semver.sort(["10.0.0", "1.0.0-rc.1", "2.0.0", "1.0.0", "1.0.0-beta.11", "1.0.0-beta.2", "1.0.0-alpha", "1.0.0+b", "1.0.0+a"]))
drop(semver.sort([]), semver.sort(["1.0.0"]))

# ranges, as in plum.toml
plant ranges = ["^1.2.3", "^0.2.3", "^0.0.3", "^1.2", "^0", "~1.2.3", "~1.2", "~1", "=1.2.3", "=1.2",
                ">=1.2", "*", "1.2", " ^ 1.2"]
plant versions = ["0.0.3", "0.0.4", "0.2.3", "0.2.9", "0.3.0", "1.2.2", "1.2.3", "1.2.9", "1.3.0",
                  "1.9.9", "2.0.0", "2.0.0-alpha"]
for r in ranges {
    plant allowed: list[str] = []
    for v in versions {
        if semver.satisfies(v, r) {
            allowed.push(v)
        }
    }
    drop("{r:>8} {allowed}")
}

# prereleases only match a range that names one on the same version
drop(semver.satisfies("1.0.0-beta.2", "^1.0.0-beta"), semver.satisfies("1.0.0", "^1.0.0-beta"))
drop(semver.satisfies("1.1.0-beta", "^1.0.0-beta"), semver.satisfies("1.0.0-alpha", "^1.0.0-beta"))
drop(semver.satisfies("1.0.0-beta", "=1.0.0-beta"), semver.satisfies("1.0.0-rc", "=1.0.0-beta"))
drop(semver.satisfies("1.0.0-beta+x", "=1.0.0-beta"), semver.satisfies("1.0.0+build", "=1.0.0"))
drop(semver.satisfies("1.5.0-rc.1", ">=1.0"), semver.satisfies("1.5.0-rc.1", ">=1.5.0-rc.0"))

drop(semver.max_satisfying(["1.2.3", "1.4.0", "2.0.0", "1.9.0-beta", "1.3.7"], "^1.2"))
drop(semver.max_satisfying(["1.2.3", "1.4.0"], "^3"), semver.max_satisfying([], "*"))
drop(semver.max_satisfying(["2.0.0-rc.1", "2.0.0-rc.2", "1.9.0"], "^2.0.0-rc.1"))

for r in ["^1.2", "~1.2.3", ">=0", "*", "=1.0.0-beta", "1", "", ">1.2", "<2", "^1.2.3.4", "1.x",
          ">=1.0, <2.0", "^01.2", "* "] {
    drop("{r:>12} {semver.is_valid_range(r)}")
}

# bump: a prerelease bumps to its own release first
for v in ["1.2.3", "1.2.3-beta", "1.2.0-beta", "1.0.0-rc.1", "0.0.0", "1.2.3+build"] {
    drop(v, semver.bump(v, "major"), semver.bump(v, "minor"), semver.bump(v, "patch"))
}

# errors
for call in [() => { drop(semver.parse("1.2")) }, () => { drop(semver.compare("1.0.0", "x")) },
             () => { drop(semver.satisfies("1.0.0", ">1")) }, () => { drop(semver.sort(["1.0.0", "01.0.0"])) },
             () => { drop(semver.bump("1.0.0", "build")) },
             () => { drop(semver.bump("999999999.0.0", "major")) },
             () => { drop(semver.max_satisfying(["1.0"], "*")) }] {
    try {
        call()
    } catch e: ValueError {
        drop(e.message)
    }
}
