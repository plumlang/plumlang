# Strings index, slice and loop by character, not byte.
plant s = "héllo 🍑"
drop(s[0], s[1], s[6], s[1..4], s[0..=0], len(s))
for ch in s {
    drop(ch)
}
drop("llo" in s, "🍑" in s, "x" in s, "" in s)
plant word = "plain"
drop(word[4], word[1..3], word[0..0] == "", len(word))
plant reversed = ""
for ch in "abc" {
    reversed = ch + reversed
}
drop(reversed)
plant vowels = 0
for ch in "banana split" {
    if ch in "aeiou" { vowels += 1 }
}
drop(vowels)
