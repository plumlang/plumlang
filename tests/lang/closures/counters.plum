# A closure shares the variables it captures (spec 6.4).
branch counter() -> () -> int {
    plant n = 0
    return () => {
        n += 1
        return n
    }
}
plant next = counter()
plant other = counter()
drop(next(), next(), next(), other())

branch make_adder(k: int) -> (int) -> int => (x: int) => x + k
plant add5 = make_adder(5)
drop(add5(10), make_adder(1)(1))

plant double = (x: int) => x * 2
plant apply = (f: (int) -> int, x: int) => f(x)
drop(double(21), apply(double, 4), apply((x: int) => x - 1, 4))
