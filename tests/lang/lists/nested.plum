# Changes deep inside collections copy only what is shared, at every level.
plant grid = [[0, 0, 0], [0, 0, 0]]
plant before = grid
grid[1][2] = 5
grid[0][1] += 3
drop(grid, before)
plant groups: map[str, list[str]] = {"a": [], "b": ["x"]}
groups["a"].push("ada")
groups["a"].push("al")
plant snap = groups
groups["b"][0] = "y"
drop(groups, snap)
plant deep = {"k": {"n": [1, 2]}}
deep["k"]["n"][1] *= 10
deep["k"]["m"] = [7]
drop(deep, deep["k"]["n"].pop(), deep)
