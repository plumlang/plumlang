# command: ast
try {
    plant text = load("config.txt")
} catch e: NotFound {
    drop("Missing: {e.path}")
} catch e {
    drop(e.message)
}
finally {
    close()
}

match command {
    "start" => start()
    "stop", "halt" => stop()
    0..10 => {
        drop("small")
        log()
    }
    else => drop("Unknown: {command}")
}

plant area = match s {
    Circle(r) => 3.14159 * r ** 2
    Rect(w, h) => w * h
    _ => 0.0
}

plant ch = Channel[int]()
spawn (() => {
    for i in 0..3 { ch.send(i) }
    ch.close()
})()
