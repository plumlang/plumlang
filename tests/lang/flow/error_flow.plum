# command: check
branch sign(n: int) -> str {
    if n > 0 { return "positive" }
    if n < 0 { return "negative" }
}
branch loop_then_nothing(xs: list[int]) -> int {
    for x in xs { return x }
}
branch leaves(n: int) -> int {
    while n > 0 {
        break
    }
}
break
branch outer() {
    for i in 0..3 {
        plant f = () => {
            continue
        }
        f()
    }
}
kind Light { Red, Yellow, Green }
plant l = Light.Red
match l {
    Red => drop("stop")
    Green => drop("go")
}
match 5 {
    1 => drop("one")
}
match good {
    good => drop("yes")
}
