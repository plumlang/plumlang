# State across entries, echoed results, :type and multi-line entries.
plant x = 1
x + 1
x = x + 41
x
branch square(n: int) -> int {
    return n * n
}
square(x)
:type square
:type x / 2
:type [x, 2]
plant name = "plum"
name.upper()
"{name} has {len(name)} letters"
2.5 * 2
x > 10 and name == "plum"
