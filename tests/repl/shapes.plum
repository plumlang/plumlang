# A module the REPL tests import with `seed ./shapes`.
drop("shapes loaded")

tree Point {
    x: int
    y: int

    branch to_str() -> str => "({self.x}, {self.y})"

    branch plus(other: Point) -> Point => Point(self.x + other.x, self.y + other.y)
}

kind Shape {
    Round(r: float)
    Square(side: float)
}

branch area(s: Shape) -> float {
    return match s {
        Round(r) => 3.0 * r * r
        Square(a) => a * a
    }
}

branch origin() -> Point => Point(0, 0)
