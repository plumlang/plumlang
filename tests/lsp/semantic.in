{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":"@ROOT@","capabilities":{}}}
{"jsonrpc":"2.0","method":"initialized","params":{}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@ROOT@/main.plum","languageId":"plum","version":1,"text":"# Semantic tokens: every kind of name.\nseed math\nseed ./lib/shapes { Shape, Form }\n\nroot LIMIT: int = 3\n\ntree Pot : Error {\n    size: float = 1.5\n\n    branch grow(by: float) -> float => self.size * by\n}\n\nkind Light {\n    Off\n    Dim(level: int)\n}\n\nbranch shine(l: Light) -> str {\n    match l {\n        Off => return \"dark\"\n        Dim(level) => return \"dim {level}\"\n    }\n}\n\nplant pot = Pot(\"full\", size: 2.0)\nfor i in 0..LIMIT {\n    drop(pot.grow(math.sqrt(2.0)), pot.message, shine(Light.Dim(i)), Form.Round, math.PI)\n}\nplant s: Shape = Shape(\"\"\"tall\nbox\"\"\", Form.Square)\n"}}}
# Five numbers a token: line and start (each from the one before), length, type, modifiers.
{"jsonrpc":"2.0","id":2,"method":"textDocument/semanticTokens/full","params":{"textDocument":{"uri":"@ROOT@/main.plum"}}}
# A file that doesn't parse still gets its keywords, strings and comments.
{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@ROOT@/main.plum","version":2},"contentChanges":[{"text":"plant x = (\"a\" # open\n"}]}}
{"jsonrpc":"2.0","id":3,"method":"textDocument/semanticTokens/full","params":{"textDocument":{"uri":"@ROOT@/main.plum"}}}
# Doc comments get the documentation modifier; a block comment, a token per line.
{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@ROOT@/main.plum","version":3},"contentChanges":[{"text":"## Doc: the documentation modifier.\nroot A = 1 #[ a block\n  over two lines ]#\n# plain\n"}]}}
{"jsonrpc":"2.0","id":4,"method":"textDocument/semanticTokens/full","params":{"textDocument":{"uri":"@ROOT@/main.plum"}}}
{"jsonrpc":"2.0","id":5,"method":"shutdown"}
{"jsonrpc":"2.0","method":"exit"}
