{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@ROOT@/main.plum","languageId":"plum","version":1,"text":"seed math\nseed ./lib/shapes { Shape, circle }\n\nroot LIMIT: int = 10\nplant words: list[str] = [\"a\", \"b\"]\n\ntree Point {\n    x: float\n    y: float = 0.0\n\n    branch length() -> float => math.sqrt(self.x * self.x + self.y * self.y)\n}\n\nbranch distance(a: Point, b: Point) -> float {\n    plant dx = a.x - b.x\n    return math.abs(dx)\n}\n\nplant p = Point(3.0, 4.0)\ndrop(p.length(), distance(p, Point(0.0)), LIMIT)\ndrop(words.push, \"x\".upper(), len(words), math.PI)\nplant s: Shape = circle(2.0)\ndrop(s.area(), s.form, (1 + 2) * 3)\nfor i, w in words.enumerate() {\n    drop(w)\n}\n"}}}
