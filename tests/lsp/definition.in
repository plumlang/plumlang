{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@ROOT@/other.plum","languageId":"plum","version":1,"text":"# only in the editor, not on disk\nbranch helper(n: int) -> int => n * 2\n\ntree Box {\n    item: int\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@ROOT@/main.plum","languageId":"plum","version":1,"text":"seed ./lib/shapes { Shape, Form }\nseed ./other\nseed ./other as o\n\nkind Light {\n    Red\n    Green\n}\n\ntree Lamp {\n    on: bool = bad\n\n    branch toggle() {\n        self.on = not self.on\n    }\n}\n\nbranch go(l: Light) -> int {\n    plant count = 0\n    match l {\n        Red => count += 1\n        Green => count += 2\n    }\n    return count\n}\n\nplant lamp = Lamp()\nlamp.toggle()\ndrop(go(Light.Green), lamp.on)\ndrop(other.helper(2), o.Box(1).item, Form.Round)\nplant s: Shape = Shape(\"a\", Form.Square)\ndrop(s.area(), s.size)\ndrop(drop)\n"}}}
