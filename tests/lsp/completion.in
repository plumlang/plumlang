{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@ROOT@/main.plum","languageId":"plum","version":1,"text":"seed math\nseed ./lib/shapes as shapes\n\nkind Dir {\n    Up\n    Down\n}\n\ntree Counter {\n    count: int = 0\n    branch bump() {\n        self.count += 1\n    }\n}\n\nbranch total(xs: list[int]) -> int {\n    plant sum = 0\n    for x in xs {\n        sum += x\n    }\n    return sum\n}\n\nplant c = Counter()\nplant names: list[str] = []\nplant ages: map[str, int] = {:}\ndrop(c.bump, names.push, ages.keys, \"a\".upper, math.sqrt, shapes.circle, Dir.Up)\n\n"}}}
