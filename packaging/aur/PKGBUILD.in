# Maintainer: Elixpo <hello at elixpo dot com>
# Generated by tools/release/packaging.sh from packaging/aur/PKGBUILD.in
# in plumlang/plumlang. Edit the template, not the AUR copy.

pkgname=plum-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Small, fast, memory-safe programming language (prebuilt static binary)"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://plum.elixpo.com"
license=('@LICENSE@')
provides=('plum')
conflicts=('plum')
options=('!strip' '!debug')
_base="https://github.com/plumlang/plumlang/releases/download/v${pkgver}"
source_x86_64=("${_base}/plum-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("${_base}/plum-${pkgver}-linux-arm64.tar.gz")
source_riscv64=("${_base}/plum-${pkgver}-linux-riscv64.tar.gz")
sha256sums_x86_64=('@SHA_linux-x86_64@')
sha256sums_aarch64=('@SHA_linux-arm64@')
sha256sums_riscv64=('@SHA_linux-riscv64@')

_srcdir() {
  case "$CARCH" in
    x86_64) echo "plum-${pkgver}-linux-x86_64" ;;
    aarch64) echo "plum-${pkgver}-linux-arm64" ;;
    riscv64) echo "plum-${pkgver}-linux-riscv64" ;;
  esac
}

check() {
  cd "$(_srcdir)"
  ./plum version | grep -F "plum ${pkgver} "
}

package() {
  cd "$(_srcdir)"
  install -Dm755 plum "$pkgdir/usr/bin/plum"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  cp -r --no-preserve=ownership LICENSES "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md
}
