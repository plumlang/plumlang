# in plumlang/plumlang. Do not edit in the tap; edit the template.
class Plum < Formula
  desc "Small, fast, memory-safe programming language"
  homepage "https://plum.elixpo.com"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    url "https://github.com/plumlang/plumlang/releases/download/v@VERSION@/plum-@VERSION@-macos-universal.tar.gz"
    sha256 "@SHA_macos-universal@"
  end

  on_linux do
    on_intel do
      url "https://github.com/plumlang/plumlang/releases/download/v@VERSION@/plum-@VERSION@-linux-x86_64.tar.gz"
      sha256 "@SHA_linux-x86_64@"
    end
    on_arm do
      url "https://github.com/plumlang/plumlang/releases/download/v@VERSION@/plum-@VERSION@-linux-arm64.tar.gz"
      sha256 "@SHA_linux-arm64@"
    end
  end

  def install
    bin.install "plum"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/plum version")
    (testpath/"hello.plum").write("drop(\"hello\")\n")
    assert_equal "hello\n", shell_output("#{bin}/plum run #{testpath}/hello.plum")
  end
end
