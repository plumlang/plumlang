# While loops and integer arithmetic: the longest Collatz chain below 300,000.
plant best = 0
plant best_start = 0
for start in 1..300000 {
    plant n = start
    plant steps = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n // 2
        } else {
            n = 3 * n + 1
        }
        steps += 1
    }
    if steps > best {
        best = steps
        best_start = start
    }
}
drop(best_start, best)
